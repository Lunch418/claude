# ── СЭД-вьювер: пример окружения. Скопировать в .env и заполнить. ──
# .env НЕ коммитить (см. .gitignore). Держать выше DocumentRoot если возможно.

# Origin фронтенда для CORS (например https://sed.example.local)
APP_ORIGIN=

# Отладка: 1 — показывать ошибки PHP (только dev!). В проде — 0.
SED_DEBUG=0

# ── PAM-бастион (SSH-джамп) ──
PAM_HOST=
PAM_PORT=22
PAM_USER=
PAM_PASSWORD=

# ── Целевая ВМ СЭД (через PAM) ──
TARGET_HOST=
TARGET_USER=
TARGET_PASSWORD=

# ── Основная БД СЭД (PostgreSQL). Роль ДОЛЖНА быть NOSUPERUSER, read-only ──
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
SED_DB_PASS=

# ── Демон ──
SED_USE_DAEMON=1
SED_DAEMON_SOCK=/tmp/sed_query.sock

# ── Аутентификация ──
# ID орг-единицы (group_id в usr) для публичного списка входа
AUTH_ORG_ID=
# Пароль администратора — bcrypt-ХЕШ (не пароль!): php -r 'echo password_hash("...",PASSWORD_BCRYPT);'
SED_ADMIN_PASS=
SED_ADMIN_NAME=Администратор
# ФИО (через ; или перевод строки), кому разрешены источники CHED/CHED2/KSP
REMOTE_USERS=
# Издатель для TOTP (отображается в приложении-аутентификаторе)
SED_2FA_ISSUER=СЭД КСП

# ── Локальная лог-БД (логи запросов, 2FA, префы). Роль NOSUPERUSER ──
LOG_DB_HOST=localhost
LOG_DB_PORT=5432
LOG_DB_NAME=
LOG_DB_USER=
LOG_DB_PASS=

# ── Источник CHED (свой вход/ВМ/БД, тот же PAM-хост) ──
CHED_PAM_USER=
CHED_PAM_PASSWORD=
CHED_TARGET_HOST=
CHED_TARGET_USER=
CHED_TARGET_PASSWORD=
CHED_DB_HOST=
CHED_DB_PORT=5432
CHED_DB_NAME=
CHED_DB_USER=
CHED_DB_PASS=

# ── Источник CHED2 (та же ВМ/креды CHED, другая база) ──
CHED2_DB_HOST=
CHED2_DB_PORT=5432
CHED2_DB_NAME=

# ── Источник KSP (полностью независимая сессия) ──
KSP_PAM_USER=
KSP_PAM_PASSWORD=
KSP_TARGET_HOST=
KSP_TARGET_USER=
KSP_TARGET_PASSWORD=
KSP_DB_HOST=
KSP_DB_PORT=5432
KSP_DB_NAME=
KSP_DB_USER=
KSP_DB_PASS=
