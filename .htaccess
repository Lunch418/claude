# Защита от прямого HTTP-доступа к секретам и исходникам (V-02).
# ВНИМАНИЕ: под Nginx .htaccess НЕ читается — см. deploy/nginx-security.conf.

# Секреты и служебные файлы по расширению/имени
<FilesMatch "(^\.env|\.(env|py|sh|sql|log|md|ini|dist|example)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Точечные файлы (.env, .git и т.п.)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known)   - [F]
</IfModule>
